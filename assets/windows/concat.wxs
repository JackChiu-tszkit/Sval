<?xml version="1.0" encoding="UTF-8"?>
<!--
  Concat's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.11 -d Root=C:\...\Concat
              -d Stage=C:\...\stage\Concat-0.2.11-windows-x86_64
              -o stage\Concat-0.2.11-windows-x86_64.msi assets\windows\concat.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="Sval"
           Manufacturer="Sval"
           Version="$(var.Version)"
           UpgradeCode="B7E2A91C-4D58-4E0A-9F63-2C8D1A6E5B40"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Sval is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="sval.ico" SourceFile="$(var.Root)\assets\icons\sval.ico" />
    <Property Id="ARPPRODUCTICON" Value="sval.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jub0t/Concat" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Sval" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="Sval" />
    </StandardDirectory>

    <Feature Id="Main" Title="Sval" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="9C1E4A72-8B36-4D5F-A0E2-7F3B6C8D1E55">
      <Shortcut Id="StartMenuShortcut"
                Name="Sval"
                Description="Video editor"
                Target="[INSTALLFOLDER]concat.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="sval.ico" />
      <!-- The way in when a graphics driver draws the window as coloured
           squares: it turns off Settings > General > Draw on the GPU,
           which that window hides. -->
      <Shortcut Id="SafeGraphicsShortcut"
                Name="Sval (safe graphics)"
                Description="Sval, drawn in software"
                Target="[INSTALLFOLDER]concat.exe"
                Arguments="--software"
                WorkingDirectory="INSTALLFOLDER"
                Icon="sval.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Sval" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
